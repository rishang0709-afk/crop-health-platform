# Crop Health Platform — Backend Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env with real secrets.

# MongoDB Atlas connection string
MONGODB_URI=

# JWT secret key — use a long, random string (min 32 characters recommended)
JWT_SECRET=

# JWT expiry — e.g. 7d, 24h, 1h
JWT_EXPIRES_IN=7d

# Server port (optional, defaults to 5000)
PORT=5000

# AI service base URL (for future AI integration)
AI_SERVICE_URL=

# Weather Service (Open-Meteo default requires no API key; set to 'mock' for tests)
WEATHER_PROVIDER=open-meteo
WEATHER_API_KEY=
WEATHER_CACHE_TTL_MINUTES=30
WEATHER_TIMEOUT_MS=5000

# Cloudinary image storage (for crop image uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
