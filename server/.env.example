# Crop Health Platform — Backend Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env with real secrets.

# MongoDB Atlas connection string
MONGODB_URI=

# JWT secret key — use a long, random string (min 32 characters recommended)
JWT_SECRET=

# JWT expiry — e.g. 7d, 24h, 1h
JWT_EXPIRES_IN=7d

# Server port (optional, defaults to 5000)
PORT=5000

# Client origin for CORS (e.g. http://localhost:5173 for local dev; set to actual frontend origin like https://your-app.vercel.app in cloud deployment)
CLIENT_ORIGIN=http://localhost:5173

# AI service base URL (FastAPI crop health predictor)
AI_SERVICE_URL=http://127.0.0.1:8000

# Weather Service (Open-Meteo default requires no API key; set to 'mock' for tests)
WEATHER_PROVIDER=open-meteo
WEATHER_API_KEY=
WEATHER_CACHE_TTL_MINUTES=30
WEATHER_TIMEOUT_MS=5000

# Cloudinary image storage (for crop image uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Demo Account Passwords (Required when running 'npm run seed:demo')
# Provide your desired test passwords in your local .env file.
DEMO_FARMER_PASSWORD=
DEMO_EXPERT_PASSWORD=
DEMO_OFFICER_PASSWORD=
DEMO_ADMIN_PASSWORD=

